<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);BROWSER</DefineConstants>
    <NoWarn>CS0169;CS0649;CS0414;CS0219;CS0168;CS0114;CS0675;CS0162;CS0108;CS8632;CS0618;SYSLIB0006;CA1416</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmBuildNative>false</WasmBuildNative>
    <PublishTrimmed>false</PublishTrimmed>
    <BlazorEnableCompression>false</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.0" />
    <PackageReference Include="Raylib-cs" Version="8.1.0" ExcludeAssets="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="WebInterop.cs" />
    <Compile Include="WebGraphicsBackend.cs" />
    <Compile Include="WebAssetLoader.cs" />
    <Compile Include="WebInputBridge.cs" />
    <Compile Include="WebStorageSync.cs" />
    <Compile Include="WebNetworkConfig.cs" />
    <Compile Include="WebPlatformBridge.cs" />
    <Compile Include="..\..\DragonBoy_Shared\Src\**\*.cs" Link="Src\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\DragonBoy_Shared\Engine\**\*.cs" Link="Engine\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
